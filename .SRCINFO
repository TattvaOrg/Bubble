pkgbase = bubble-git
	pkgdesc = A lightweight Qt6/QML file manager for Linux (Pure Rust)
	pkgver = 0.6.1.r200.gca5ce09
	pkgrel = 1
	url = https://github.com/Naitik-Vadher-4661/BUBBLE-RUST
	arch = x86_64
