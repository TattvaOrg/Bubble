	depends = gvfs
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	depends = qt6-wayland
	depends = xdg-utils
	depends = openssl
	depends = argon2
	depends = sqlite
	optdepends = wl-clipboard: clipboard support via wl-copy and wl-paste
	optdepends = fd: fast recursive search (falls back to a built-in walker)
	optdepends = bat: syntax-highlighted text previews
	optdepends = gvfs-smb: SMB/CIFS remote browsing support
	optdepends = gvfs-mtp: Android phones (MTP) in the sidebar
	optdepends = ffmpeg: video thumbnails and audio/video metadata
	optdepends = poppler: PDF thumbnails, previews, and metadata
	optdepends = perl-image-exiftool: EXIF metadata for images
	optdepends = udisks2: mount/unmount devices from sidebar
